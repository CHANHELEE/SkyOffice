# Copy to .env and fill in. .env is gitignored - never commit real values.

# The Supabase project behind the igloo web service. The room decides who may
# come in by asking it whether the person at the door is a member, so the server
# refuses to boot without these. (server/iglooAuth.ts)
#
# Use the publishable (anon) key, the same one the web service puts in the
# browser. Every query goes out with the member's own token and RLS does the
# real work. The service role key must never be put on this server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Game server port. Optional, defaults to 2567.
# PORT=2567
