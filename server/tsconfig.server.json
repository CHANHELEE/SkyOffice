{
  "compilerOptions": {
    "outDir": "lib",
    "target": "es6",
    // fetch/Response live in the DOM lib; the server uses them to talk to Supabase
    "lib": ["ES2021", "DOM"],
    "module": "commonjs",
    "strict": true,
    "allowJs": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["."]
}
