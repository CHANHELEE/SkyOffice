# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed names.

# The same Supabase project the igloo web service uses - that is the whole point.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Scope of the session cookie, and the reason logging in on either side counts
# on both. Set to `.myigloos.com` in production so this app and the web service
# share one cookie.
#
# LEAVE EMPTY LOCALLY. A domain attribute on `localhost` makes the browser throw
# the cookie away. Empty still works: cookies ignore ports, so what
# localhost:3000 sets, localhost:5173 reads.
VITE_COOKIE_DOMAIN=

# Where to hand somebody over when they have to finish something on the web side
# (entering an invite code, waiting for approval).
VITE_IGLOO_WEB_URL=http://localhost:3000

# Colyseus server. Only read in production builds; dev talks to localhost:2567.
# VITE_SERVER_URL=wss://igloo-skyoffice-server.onrender.com
